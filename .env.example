NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (mobile apps don't need CORS)
CORS_ORIGINS=http://localhost:8081

DATABASE_URL=postgres://spool:spool@localhost:5432/spool
# Auto-sync schema from entities. Use migrations (npm run migration:run) in production.
DB_SYNCHRONIZE=false

# Use long random strings in production, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Session summaries: "anthropic" (Claude) or "local" (offline heuristic, for dev/tests)
SUMMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
