NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (mobile apps don't need CORS)
CORS_ORIGINS=http://localhost:8081

DATABASE_URL=postgres://spool:spool@localhost:5432/spool
# Auto-sync schema from entities. Use migrations (npm run migration:run) in production.
DB_SYNCHRONIZE=false

# Use long random strings in production, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Session summaries: "openai", "anthropic" (Claude) or "local" (offline heuristic,
# for dev/tests). Leave empty to pick automatically: openai when OPENAI_API_KEY is
# set, otherwise anthropic. If the model API is unreachable, the local summary is used.
SUMMARY_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Number of reverse proxies in front of the API (1 behind nginx); 0 = none.
TRUST_PROXY=0

# Admin analytics dashboard (spool-web /admin). One login, read from here.
# Leave ADMIN_PASSWORD empty to disable admin login. Use a long random password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_TTL=8h
